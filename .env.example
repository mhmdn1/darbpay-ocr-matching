# Optional override. Without an .env file, the app uses this local SQLite path.
DATABASE_URL="file:./dev.db"

# Optional webhook verification. Leave unset for the fixture demo.
EMAIL_WEBHOOK_SECRET=""
WHATSAPP_WEBHOOK_SECRET=""

# Optional on-demand LLM explanations. Without a key, the deterministic local
# explainer is used and the complete demo remains available offline.
OPENAI_API_KEY=""
OPENAI_EXPLANATION_MODEL="gpt-5.4"
