{
  "name": "darb-takehome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:edge": "jest --runInBand __tests__/matcher-edge-matrix.test.ts",
    "test:matcher": "jest --runInBand __tests__/matcher.test.ts __tests__/normalization.test.ts __tests__/matcher-edge-matrix.test.ts",
    "test:explanations": "jest --runInBand __tests__/match-explanation.test.ts",
    "test:all": "jest --runInBand",
    "check": "npm run lint && tsc --noEmit",
    "verify": "npm run test:all && npm run check && npm run build",
    "matcher:evaluate": "node --import tsx scripts/evaluate-matcher.ts",
    "db:generate": "prisma generate",
    "db:init": "node scripts/ensure-sqlite-db.mjs",
    "db:migrate": "npm run db:init && prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "demo:seed": "node --import tsx prisma/seed.ts",
    "demo:setup": "npm run db:generate && npm run db:migrate && npm run demo:seed",
    "demo": "npm run demo:setup && npm run dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-safe-action": "^8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  }
}
